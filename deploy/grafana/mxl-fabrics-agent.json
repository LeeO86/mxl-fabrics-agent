{
  "title": "mxl-fabrics-agent",
  "uid": "mxl-fabrics-agent",
  "schemaVersion": 39,
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "host_id",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(mxl_fabrics_agent_info, host_id)",
        "refresh": 2
      }
    ]
  },
  "panels": [
    {"id": 1, "type": "stat", "title": "Peers up", "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0}, "targets": [{"expr": "mxl_fabrics_agent_peers_up{host_id=\"$host_id\"}"}]},
    {"id": 2, "type": "timeseries", "title": "Throughput", "gridPos": {"h": 8, "w": 12, "x": 6, "y": 0}, "targets": [{"expr": "sum by (flow_id) (rate(mxl_fabrics_agent_replication_bytes_total{host_id=\"$host_id\"}[1m]))"}]},
    {"id": 3, "type": "timeseries", "title": "Lag", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}, "targets": [{"expr": "mxl_fabrics_agent_replication_lag_grains{host_id=\"$host_id\"}"}]},
    {"id": 4, "type": "timeseries", "title": "Errors", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}, "targets": [{"expr": "sum by (flow_id, role) (rate(mxl_fabrics_agent_replication_errors_total{host_id=\"$host_id\"}[5m]))"}]},
    {"id": 5, "type": "timeseries", "title": "tmpfs free", "gridPos": {"h": 6, "w": 8, "x": 0, "y": 16}, "targets": [{"expr": "mxl_fabrics_agent_tmpfs_free_bytes{host_id=\"$host_id\"}"}]},
    {"id": 6, "type": "stat", "title": "TAI offset", "gridPos": {"h": 6, "w": 4, "x": 8, "y": 16}, "targets": [{"expr": "mxl_fabrics_agent_tai_offset_seconds{host_id=\"$host_id\"}"}]}
  ]
}
